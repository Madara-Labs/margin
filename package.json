{
  "name": "margin-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sidecar": "python3 sidecar/main.py",
    "start": "concurrently \"npm run sidecar\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:py": "PYTHONPATH=. pytest tests/python",
    "test:all": "vitest run && PYTHONPATH=. pytest tests/python",
    "demo:bolton": "npx tsx scripts/demo-bolton-4-2.ts",
    "ingest": "PYTHONPATH=. python3 scripts/ingest_book.py"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "mathjs": "^13.2.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
